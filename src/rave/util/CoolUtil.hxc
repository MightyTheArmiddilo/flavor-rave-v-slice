package rave.util;

import funkin.data.quickpanel.PanelRegistry;
import funkin.ui.quickpanel.PanelEntry;

class CoolUtil
{
	public static function numberArray(max:Int, ?min:Int = 0):Array<Int>
	{
		var result = [];
		for (i in min...max) result.push(i);
		return result;
	}

	public static function removeCustomSidebarPanels(panel:String)
	{
		@:privateAccess
		for (entry => what in PanelRegistry.instance.entries)
		{
			if (!entry.startsWith('$panel-')) continue;

			PanelRegistry.instance.entries.remove(entry);
		}
	}

	public static function createSidebarPanelsBasedOnOGS(panel:String, wanted:Array<String>)
	{
		@:privateAccess
		for (entry => what in PanelRegistry.instance.entries)
		{
			if (!wanted.contains(entry)) continue;
			if (PanelRegistry.instance.entries.exists('$panel-$entry')) continue;

			var newEntry = new PanelEntry(entry);
			newEntry._data.panel = panel;
			newEntry._data.order = wanted.indexOf(entry);
			PanelRegistry.instance.entries.set('$panel-$entry', newEntry);
		}

		trace(PanelRegistry.instance.listPanelEntries(panel));
	}

	public static function listFilesInPath(path:String, suffix:String = '.json', ?blacklist:Array<String>, nested:Bool = false):Array<String>
	{
		var queryPath:String = 'assets/${path}';
		var assets:Array<String> = Assets.list();

		var results:Array<String> = [];
		for (textPath in assets)
		{
			// Filter matching assets
			if (!StringTools.startsWith(textPath, queryPath) || !StringTools.endsWith(textPath, suffix)) continue;

			// Isolate raw path
			var pathNoPrefix:String = textPath.substring(queryPath.length, textPath.length - suffix.length);
			var id:String = nested ? pathNoPrefix.split('/')[0] : pathNoPrefix;

			if (nested && !StringTools.endsWith(textPath, '$id$suffix')) continue;

			if (blacklist != null && blacklist.contains(id)) continue;

			if (!results.contains(id)) results.push(id);
		}

		return results;
	}
}
